# ==============================================================================
# Autonomous AI Agent for Enterprise Task Automation - Environment Config
# ==============================================================================

# --- AI & LLM Provider Settings ---
# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048

# --- Google Workspace OAuth 2.0 Credentials ---
# Downloaded from Google Cloud Console (Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- Supabase Cloud Database & Storage ---
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# --- Persistence & Storage ---
DATABASE_URL=sqlite:///./tasks.db
LOG_LEVEL=INFO
APP_ENV=development

# --- Security & Token Encryption ---
# 32-url-safe base64-encoded key for token encryption (optional)
AGENT_ENCRYPTION_KEY=
